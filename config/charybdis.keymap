#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define U_TAPPING_TERM 200

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&zip_xy_scaler 1 2>, <&zip_temp_layer 4 400>;

        // Switch to auto-mouse temp layer, decrease sensitivity

        scroll {
            layers = <5>; // SCROLL
            input-processors =
                <&zip_xy_scaler 1 5>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        LeftClickRight {
            bindings = <&mkp LCLK>;
            key-positions = <31 32>;
        };

        RightClickRight {
            bindings = <&mkp RCLK>;
            key-positions = <32 33>;
        };

        MiddleClickRight {
            bindings = <&mkp MCLK>;
            key-positions = <33 34>;
        };

        ParaLeft {
            bindings = <&kp LS(N8)>;
            key-positions = <16 14>;
        };

        ParaRight {
            bindings = <&kp LS(N9)>;
            key-positions = <19 21>;
        };

        BrakLeft {
            bindings = <&kp RBKT>;
            key-positions = <26 28>;
        };

        BrakRight {
            bindings = <&kp BSLH>;
            key-positions = <31 33>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;
        };

        underbar {
            bindings = <&kp LS(INT1)>;
            key-positions = <20 21>;
        };

        win {
            bindings = <&kp LEFT_GUI>;
            key-positions = <20 19 21>;
        };

        henkan {
            bindings = <&kp INTERNATIONAL_4>;
            key-positions = <38 39>;
        };

        space {
            bindings = <&kp LS(SPACE)>;
            key-positions = <37 40>;
        };
    };

    behaviors {
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "u_mt";
            #binding-cells = <2>;
            tapping_term_ms = <U_TAPPING_TERM>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "u_lt";
            #binding-cells = <2>;
            tapping_term_ms = <U_TAPPING_TERM>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        Shift_Enter: Shift_Enter {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT_ENTER";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <40>;
            tapping-term-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC       &kp Q  &kp W    &kp E     &kp R        &kp T                     &kp Y                 &kp U             &kp I      &kp O    &kp P      &kp DEL
&kp TAB       &kp A  &lt 2 S  &lt 3 D   &mt LSHFT F  &kp G                     &kp H                 &mt LEFT_SHIFT J  &kp K      &kp L    &kp ENTER  &kp RALT
&lt 5 ESCAPE  &kp Z  &kp X    &kp C     &kp V        &kp B                     &kp N                 &kp M             &kp COMMA  &kp DOT  &kp FSLH   &lt 5 LS(BACKSPACE)
                              &mkp MB1  &lt 1 SPACE  &mt LEFT_CONTROL LANG2    &mt LSHFT LANGUAGE_1  &lt 1 SPACE
            >;
        };

        NAV {
            bindings = <
&trans     &kp N6     &kp N7        &kp N8         &kp N9        &kp N0     &kp LG(Z)            &kp HOME           &kp UP_ARROW    &kp END          &trans  &trans
&trans     &kp N1     &kp N2        &kp N3         &kp N4        &kp N5     &kp BACKSPACE        &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&kp LC(Z)  &kp LSHFT  &kp LS(APOS)  &kp LS(MINUS)  &kp LS(SEMI)  &kp DOT    &kp LEFT_BRACKET     &kp F7             &kp F2          &kp F10          &trans  &trans
                                    &trans         &trans        &trans     &mt LA(LC(V)) LC(V)  &u_mt LC(X) LC(C)
            >;
        };

        SYMNUM {
            bindings = <
&none   &none  &none  &kp UP_ARROW    &kp C_VOL_DN     &kp C_VOL_UP    &kp SEMI  &kp AMPS  &kp LS(N2)  &kp HASH    &kp RPAR   &kp DEL
&none   &none  &none  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp C_PP        &kp BSPC  &kp FSLH  &kp LS(N6)  &kp LS(N4)  &trans     &trans
&trans  &none  &none  &kp DOWN_ARROW  &trans           &trans          &kp LBKT  &kp EXCL  &kp PRCNT   &kp INT3    &kp RSHFT  &trans
                      &trans          &trans           &trans          &trans    &trans
            >;
        };

        FUN {
            bindings = <
&rgb_ug RGB_ON                  &rgb_ug RGB_OFF  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_HUI    &rgb_ug RGB_HUD    &kp F11          &kp F7           &kp F8  &kp F9  &kp F10    &rgb_ug RGB_SPI
&rgb_ug RGB_BRI                 &rgb_ug RGB_BRD  &kp LC(PG_UP)    &none            &kp LC(PAGE_DOWN)  &kp K_APP          &kp BSPC         &kp F4           &kp F5  &kp F6  &trans     &trans
&rgb_ug RGB_COLOR_HSB(0,0,100)  &kp LSHFT        &kp LS(F11)      &none            &kp LC(N1)         &none              &kp F12          &kp F1           &kp F2  &kp F3  &kp RSHFT  &rgb_ug RGB_SPD
                                                                  &trans           &trans             &trans             &rgb_ug RGB_SAI  &rgb_ug RGB_SAD
            >;
        };

        AUTO-MOUSE {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
                        &mkp LCLK  &mkp LCLK  &mkp RCLK    &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };
    };
};
